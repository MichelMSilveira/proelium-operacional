[Unit]
Description=Proelium NestJS API
After=network.target postgresql.service proelium.service

[Service]
Type=simple
WorkingDirectory=/opt/proelium-operacional/backend-nest
Environment=NODE_ENV=production
Environment=PORT=4174
Environment=LEGACY_API_ORIGIN=http://127.0.0.1:4173
EnvironmentFile=-/etc/proelium/database.env
ExecStart=/usr/bin/node /opt/proelium-operacional/backend-nest/dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
